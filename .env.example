# ==============================================================================
# MailGuard AI - Environment Configuration Example
# Copy this file to .env for local development overrides:
#   cp .env.example .env
# Note: In production (Render, Docker, Linux VMs), configure these via platform
# environment settings. Defaults are cross-platform and production-ready.
# ==============================================================================

# Server Network & Runtime
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# Model & Artifact Storage Paths
MODEL_PATH=models/spam_pipeline.joblib
METADATA_PATH=models/metadata.json
RAW_DATA_PATH=data/raw/enron_spam_data.csv
PROCESSED_DATA_PATH=data/processed/cleaned_emails.csv

# Classification & Uncertain Band Thresholds
# Emails with spam probability within [UNCERTAIN_LOWER, UNCERTAIN_UPPER] are flagged as "uncertain"
UNCERTAIN_LOWER=0.40
UNCERTAIN_UPPER=0.60

# Decision Boundary Proximity Warning Thresholds
BOUNDARY_LOWER=0.35
BOUNDARY_UPPER=0.65

# Reliability Heuristic Thresholds
MIN_TOKEN_COUNT=10
MIN_VOCAB_COVERAGE=0.50

# Request Body & Input Payload Limits (Security & DoS Prevention)
MAX_CONTENT_LENGTH=2097152
MAX_INPUT_CHARS=20000
